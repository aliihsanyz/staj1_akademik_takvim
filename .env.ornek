# Bu dosyayi ".env" adiyla kopyalayin; docker compose onu otomatik okur.
#   cp .env.ornek .env
# ".env" dosyasi .gitignore'da oldugu icin depoya GIRMEZ; sifreler kod deposunda
# durmamalidir.

# Veritabani kullanicisi ve sifresi (kap icindeki PostgreSQL icin de gecerlidir)
DB_KULLANICI=postgres
DB_SIFRE=admin123

# Uygulama ilk acildiginda olusturulan "admin" hesabinin sifresi
ADMIN_SIFRESI=admin123

# Demo etkinlikler yuklensin mi? Gercek kurulumda false yapin.
ORNEK_VERI_YUKLE=true
